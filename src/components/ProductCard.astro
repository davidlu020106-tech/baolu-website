---
export interface Props {
  name: string;
  description: string;
  specs: string;
  source: string;
}
const { name, description, specs, source } = Astro.props;
const specLines = specs.split('\n').filter(s => s.trim());
---
<div class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 overflow-hidden">
  <div class="p-6">
    <h3 class="text-lg font-bold text-white mb-2">{name}</h3>
    <p class="text-sm text-baolu-gray mb-4 leading-relaxed">{description}</p>
    <details class="group">
      <summary class="cursor-pointer text-sm text-baolu-accent font-medium hover:underline">View Specifications ▾</summary>
      <div class="mt-3 pt-3 border-t border-baolu-blue/20">
        <ul class="space-y-1">
          {specLines.map(line => (
            <li class="text-xs text-baolu-gray/80 pl-2 border-l-2 border-baolu-accent/30">{line.trim()}</li>
          ))}
        </ul>
      </div>
    </details>
    <div class="mt-4 flex items-center justify-between">
      <span class="text-xs text-baolu-gray/50">Ref: {source}</span>
      <a href="/contact" class="text-sm px-4 py-1.5 rounded-lg bg-baolu-accent/20 text-baolu-accent font-medium hover:bg-baolu-accent/30 transition-colors">Inquire</a>
    </div>
  </div>
</div>
