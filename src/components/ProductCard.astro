---
export interface Props {
  name: string;
  description: string;
  specs: string;
  source: string;
  category?: string;
  slug?: string;
}
const { name, description, specs, source, category = "radar", slug } = Astro.props;

function toSlug(name: string): string {
  return name
    .toLowerCase()
    .replace(/[^a-z0-9\u4e00-\u9fff]+/g, "-")
    .replace(/^-|-$/g, "")
    .substring(0, 80);
}
const detailSlug = slug || toSlug(name);
const specLines = specs.split('\n').filter(s => s.trim());
const highlight = specLines.slice(0, 2);
---

<div class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 overflow-hidden">
  <div class="p-6">
    <h3 class="text-lg font-bold text-white mb-2">{name}</h3>
    <p class="text-sm text-baolu-gray mb-3 leading-relaxed line-clamp-2">{description}</p>
    
    {highlight.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-4">
        {highlight.map(line => {
          const clean = line.replace(/^[：:]\s*/, "").substring(0, 35);
          return <span class="text-xs px-2 py-1 rounded-md bg-baolu-blue/15 text-baolu-light/70">{clean}</span>;
        })}
      </div>
    )}

    <div class="flex items-center justify-between pt-3 border-t border-baolu-blue/15">
      <span class="text-xs text-baolu-gray/50">{source}</span>
      <a href={`/products/${category}/${detailSlug}`} class="text-sm px-4 py-1.5 rounded-lg bg-baolu-accent/15 text-baolu-accent font-medium hover:bg-baolu-accent/25 transition-colors">
        View Details →
      </a>
    </div>
  </div>
</div>
