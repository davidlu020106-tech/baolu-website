---
import '../styles/global.css';

import Seo from "../components/Seo.astro";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Baolu Tech — Radar-Centric Anti-Drone Solutions',
  description = 'Professional anti-drone radar systems, jammers, spectrum detection and individual gear for airspace security.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Seo title={title} description={description} canonical={Astro.url.pathname} />
    <meta name="keywords" content="anti-drone, counter-UAS, radar system, drone jammer, spectrum detection, airspace security" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
      <link rel="alternate" hreflang="en" href={`https://baolu-tech.com${Astro.url.pathname}`} />
    <link rel="alternate" hreflang="x-default" href={`https://baolu-tech.com${Astro.url.pathname}`} />
  </head>
  <body class="min-h-screen bg-baolu-dark text-baolu-light">
    <header class="fixed top-0 left-0 right-0 z-50 bg-baolu-dark/90 backdrop-blur-md border-b border-baolu-blue/20">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <span class="text-xl font-bold tracking-tight">
            <span class="text-baolu-accent">BAOLU</span>
            <span class="text-white">TECH</span>
          </span>
        </a>
        <div class="hidden md:flex items-center gap-8">
          <a href="/" class="text-sm font-medium text-baolu-light/80 hover:text-baolu-accent transition-colors">Home</a>
          <a href="/products" class="text-sm font-medium text-baolu-light/80 hover:text-baolu-accent transition-colors">Products</a>
          <a href="/solutions" class="text-sm font-medium text-baolu-light/80 hover:text-baolu-accent transition-colors">Solutions</a>
          <a href="/about" class="text-sm font-medium text-baolu-light/80 hover:text-baolu-accent transition-colors">About Us</a>
          <a href="/contact" class="text-sm font-medium text-baolu-light/80 hover:text-baolu-accent transition-colors">Contact</a>
        </div>
        <a href="/contact" class="hidden md:inline-flex items-center px-4 py-2 rounded-lg bg-baolu-accent text-white text-sm font-semibold hover:bg-baolu-accent/90 transition-colors">
          Get a Quote
        </a>
        <button class="md:hidden text-white" aria-label="Menu">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-baolu-navy border-t border-baolu-blue/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div class="col-span-1 md:col-span-2">
            <span class="text-xl font-bold tracking-tight">
              <span class="text-baolu-accent">BAOLU</span>
              <span class="text-white">TECH</span>
            </span>
            <p class="mt-3 text-sm text-baolu-gray max-w-md">
              Jinan Baolu Technology Co., Ltd. — Professional radar-centric anti-drone and airspace security solutions provider.
            </p>
            <p class="mt-2 text-sm text-baolu-gray">
              &copy; {new Date().getFullYear()} Baolu Tech. All rights reserved.
            </p>
          </div>
          <div>
            <h4 class="text-sm font-semibold text-white mb-4">Products</h4>
            <ul class="space-y-2">
              <li><a href="/products/radar" class="text-sm text-baolu-gray hover:text-baolu-accent transition-colors">Radar Systems</a></li>
              <li><a href="/products/jammer" class="text-sm text-baolu-gray hover:text-baolu-accent transition-colors">Countermeasure Systems</a></li>
              <li><a href="/products/spectrum" class="text-sm text-baolu-gray hover:text-baolu-accent transition-colors">Spectrum Detection</a></li>
              <li><a href="/products/individual-gear" class="text-sm text-baolu-gray hover:text-baolu-accent transition-colors">Individual Gear</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-sm font-semibold text-white mb-4">Contact</h4>
            <ul class="space-y-2 text-sm text-baolu-gray">
              <li>sales@baolu-tech.com</li>
              <li>+86-19524697801</li>
              <li>Jinan, Shandong, China</li>
            </ul>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
