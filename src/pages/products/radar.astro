---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Radar Systems — Baolu Tech">
  <section class="hero-gradient pt-32 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-baolu-gray mb-4"><a href="/" class="hover:text-baolu-accent">Home</a> / <a href="/products" class="hover:text-baolu-accent">Products</a> / <span class="text-baolu-light">Radar Systems</span></nav>
      <h1 class="text-4xl font-bold text-white">Radar Systems</h1>
      <p class="mt-4 text-baolu-light/70 max-w-2xl">Low-altitude surveillance and ground surveillance radars with phased array technology for comprehensive airspace security.</p>
    </div>
  </section>
  <section class="py-16 bg-baolu-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="text-baolu-gray">Product specifications coming soon. Contact us for detailed information on our radar product line.</p>
      </div>
      <div class="text-center">
        <a href="/contact" class="inline-flex items-center px-6 py-3 rounded-lg bg-baolu-accent text-white font-semibold hover:bg-baolu-accent/90">Inquire About Radar Products</a>
      </div>
    </div>
  </section>
</Layout>