---
import Layout from "../../../layouts/Layout.astro";
import ProductSpecs from "../../../components/ProductSpecs.astro";



const categoryTitles = {
  radar: "Radar Systems", jammer: "Countermeasure Systems",
  spectrum: "Spectrum Detection", individual: "Individual Gear",
  eoir: "EO/IR Systems", solution: "Integrated Solutions",
};
function extractModel(name) {
  const m = name.match(/^([A-Z]+[-/][A-Z0-9]+)/);
  return m ? m[1] : '';
}
function toSlug(name) {
  return name.toLowerCase().replace(/[^a-z0-9一-鿿]+/g, "-").replace(/^-|-$/g, "").substring(0, 80);
}
function extractKeySpecs(specs) {
  const range = specs.filter(s => /(探测|检测|detection|range|距离).*[0-9]/.test(s) && s.length < 60).slice(0, 2);
  const freq = specs.filter(s => /(频段|频率|frequency|band|GHz|MHz|X波段).*[0-9]/.test(s) && s.length < 60).slice(0, 1);
  const weight = specs.filter(s => /(重量|weight|kg).*[0-9]/.test(s) && s.length < 40).slice(0, 1);
  return [...range, ...freq, ...weight].slice(0, 4);
}
function buildProductSchema(product, categoryTitle2) {
  const keyFields = (product.raw_specs || []).filter(s => /(距离|范围|频段|重量|防护|功率|探测|detection|range|frequency|weight|protection|power).{0,30}[:：]/.test(s)).slice(0, 6);
  const props = keyFields.map(s => { const parts = s.split(/[:：]/); return parts.length > 1 ? { name: parts[0].trim(), value: parts.slice(1).join(':').trim() } : null; }).filter(Boolean);
  return { "@context": "https://schema.org", "@type": "Product", "name": product.product_name, "description": (product.description || '').substring(0, 200), "brand": { "@type": "Brand", "name": "Baolu Tech" }, "category": categoryTitle2, "manufacturer": { "@type": "Organization", "name": "Jinan Baolu Technology Co., Ltd." }, "offers": { "@type": "Offer", "availability": "https://schema.org/InStock", "seller": { "@type": "Organization", "name": "Baolu Tech" } }, "additionalProperty": props };
}
function buildBreadcrumbSchema(category, catTitle, productName) {
  return { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "item": { "@id": "https://baolu-tech.com/", "name": "Home" } },
    { "@type": "ListItem", "position": 2, "item": { "@id": "https://baolu-tech.com/products/", "name": "Products" } },
    { "@type": "ListItem", "position": 3, "item": { "@id": "https://baolu-tech.com/products/" + category + "/", "name": catTitle } },
    { "@type": "ListItem", "position": 4, "item": { "@id": "https://baolu-tech.com/products/" + category + "/" + toSlug(productName) + "/", "name": extractModel(productName) || productName } }
  ]};
}


export async function getStaticPaths() {
  const categoryTitles = {
    radar: "Radar Systems", jammer: "Countermeasure Systems",
    spectrum: "Spectrum Detection", individual: "Individual Gear",
    eoir: "EO/IR Systems", solution: "Integrated Solutions",
  };
  function toSlug(name) {
    return name.toLowerCase().replace(/[^a-z0-9一-鿿]+/g, "-").replace(/^-|-$/g, "").substring(0, 80);
  }
  function extractModel(name) {
    const m = name.match(/^([A-Z]+[-/][A-Z0-9]+)/);
    return m ? m[1] : '';
  }
  function extractKeySpecs(specs) {
    const range = specs.filter(s => /(探测|检测|detection|range|距离).*[0-9]/.test(s) && s.length < 60).slice(0, 2);
    const freq = specs.filter(s => /(频段|频率|frequency|band|GHz|MHz|X波段).*[0-9]/.test(s) && s.length < 60).slice(0, 1);
    const weight = specs.filter(s => /(重量|weight|kg).*[0-9]/.test(s) && s.length < 40).slice(0, 1);
    return [...range, ...freq, ...weight].slice(0, 4);
  }
  function buildProductSchema(product, categoryTitle2) {
    const keyFields = (product.raw_specs || []).filter(s => /(距离|范围|频段|重量|防护|功率|探测|detection|range|frequency|weight|protection|power).{0,30}[:：]/.test(s)).slice(0, 6);
    const props = keyFields.map(s => {
      const parts = s.split(/[:：]/);
      return parts.length > 1 ? { name: parts[0].trim(), value: parts.slice(1).join(':').trim() } : null;
    }).filter(Boolean);
    return {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": product.product_name,
      "description": (product.description || '').substring(0, 200),
      "brand": { "@type": "Brand", "name": "Baolu Tech" },
      "category": categoryTitle2,
      "manufacturer": { "@type": "Organization", "name": "Jinan Baolu Technology Co., Ltd." },
      "offers": { "@type": "Offer", "availability": "https://schema.org/InStock", "seller": { "@type": "Organization", "name": "Baolu Tech" } },
      "additionalProperty": props
    };
  }
  function buildBreadcrumbSchema(category, categoryTitle2, productName) {
    const siteUrl = "https://baolu-tech.com";
    return {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "item": { "@id": siteUrl + "/", "name": "Home" } },
        { "@type": "ListItem", "position": 2, "item": { "@id": siteUrl + "/products/", "name": "Products" } },
        { "@type": "ListItem", "position": 3, "item": { "@id": siteUrl + "/products/" + category + "/", "name": categoryTitle2 } },
        { "@type": "ListItem", "position": 4, "item": { "@id": siteUrl + "/products/" + category + "/" + toSlug(productName) + "/", "name": extractModel(productName) || productName } }
      ]
    };
  }

  const globbed = import.meta.glob("../../../data/products-catalog.json", { eager: true, import: "default" });
  const fPath = Object.keys(globbed)[0];
  const catalog = fPath ? globbed[fPath] : {};
  const paths = [];
  for (const [cat, products] of Object.entries(catalog)) {
    const title = categoryTitles[cat] || cat;
    for (const product of products) {
      paths.push({
        params: { category: cat, slug: toSlug(product.product_name) },
        props: { product, categoryTitle: title, allProducts: products },
      });
    }
  }
  return paths;
}

const { product, categoryTitle, allProducts } = Astro.props;
const specLines = (product.raw_specs || []).filter(s => s.trim());
const model = extractModel(product.product_name);
const keySpecs = extractKeySpecs(specLines);
const related = (allProducts || []).filter(p => p.product_name !== product.product_name).slice(0, 3);

// Build meta
const pageTitle = `${model || product.product_name} — ${categoryTitle} | Baolu Tech`;
const firstSpecs = specLines.slice(0, 2).map(s => s.replace(/^[^:]*:\s*/, '').substring(0, 40)).join(' | ');
const pageDesc = `${categoryTitle}: ${model || product.product_name}. ${firstSpecs || 'Professional anti-drone and security system.'} Contact Baolu Tech for specifications and pricing.`;
const pageKeywords = [categoryTitle.toLowerCase(), model.toLowerCase(), 'anti-drone', 'Baolu Tech', 'counter-UAS'].filter(Boolean).join(', ');

// Build structured data
const productSchema = buildProductSchema(product, categoryTitle);
const breadcrumbSchema = buildBreadcrumbSchema(Astro.params.category, categoryTitle, product.product_name);
---

<Layout title={pageTitle} description={pageDesc} keywords={pageKeywords}>
  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="bg-baolu-dark/80 border-b border-baolu-blue/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <nav class="text-sm text-baolu-gray">
        <a href="/" class="hover:text-baolu-accent">Home</a><span class="mx-2">/</span>
        <a href="/products" class="hover:text-baolu-accent">Products</a><span class="mx-2">/</span>
        <a href={`/products/${Astro.params.category}`} class="hover:text-baolu-accent">{categoryTitle}</a><span class="mx-2">/</span>
        <span class="text-white/60">{product.product_name}</span>
      </nav>
    </div>
  </section>

  <section class="hero-gradient py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row gap-8 items-start">
        <div class="w-full lg:w-96 aspect-4/3 rounded-xl bg-gradient-to-br from-baolu-navy/80 to-baolu-blue/20 border border-baolu-blue/20 flex items-center justify-center shrink-0">
          <div class="text-center p-8 text-baolu-gray/60 text-sm">Product Image</div>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-center gap-2.5 mb-3">
            <span class="text-xs font-semibold px-3 py-1 rounded-full bg-baolu-accent/15 text-baolu-accent border border-baolu-accent/20">{categoryTitle}</span>
            {model && <span class="text-xs font-mono px-3 py-1 rounded-full bg-baolu-blue/15 text-baolu-blue border border-baolu-blue/20">{model}</span>}
            <span class="text-xs text-baolu-gray/50">Baolu Tech</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold text-white leading-tight">{product.product_name}</h1>
          <p class="mt-4 text-baolu-light/70 leading-relaxed max-w-2xl">{product.description || "Professional anti-drone and security system."}</p>

          {keySpecs.length > 0 && (
            <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3">
              {keySpecs.map(spec => {
                const clean = spec.replace(/^[^:]*:\s*/, '');
                const label = spec.includes(':') ? spec.split(':')[0].trim() : '';
                return <div class="bg-baolu-navy/60 border border-baolu-blue/15 rounded-lg p-3">
                  {label && <div class="text-xs text-baolu-gray/60 mb-0.5 truncate">{label}</div>}
                  <div class="text-sm font-semibold text-white truncate">{clean}</div>
                </div>;
              })}
            </div>
          )}

          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-baolu-accent text-white font-semibold hover:bg-baolu-accent/90 transition-all shadow-lg shadow-baolu-accent/20">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
              Request Quote
            </a>
            <a href={`/products/${Astro.params.category}`} class="inline-flex items-center px-6 py-3 rounded-lg border border-baolu-blue/30 text-white font-semibold hover:bg-baolu-blue/20 transition-all">All {categoryTitle}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 bg-baolu-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <h2 class="text-2xl font-bold text-white">Technical Specifications</h2>
        <div class="flex-1 h-px bg-gradient-to-r from-baolu-blue/30 to-transparent"></div>
      </div>
      <div class="rounded-xl bg-baolu-navy/30 border border-baolu-blue/10 p-6 sm:p-8">
        {specLines.length > 0 ? <ProductSpecs specs={specLines} /> : (
          <div class="text-center py-8">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="#1a5276" class="w-12 h-12 mx-auto mb-3"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" /></svg>
            <p class="text-baolu-gray">Detailed specifications available upon request.</p>
            <a href="/contact" class="mt-4 inline-block text-baolu-accent hover:underline">Contact our team →</a>
          </div>
        )}
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="py-12 bg-baolu-navy/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-3 mb-6">
          <h2 class="text-xl font-bold text-white">Related Products</h2>
          <div class="flex-1 h-px bg-gradient-to-r from-baolu-blue/30 to-transparent"></div>
          <a href={`/products/${Astro.params.category}`} class="text-sm text-baolu-accent hover:underline shrink-0">View All →</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {related.map(p => {
            const rSlug = toSlug(p.product_name);
            const rSpecs = (p.raw_specs || []).slice(0, 2);
            return <a href={`/products/${Astro.params.category}/${rSlug}`} class="block card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/15 p-5 group">
              <div class="text-xs font-medium text-baolu-accent mb-1">{categoryTitle}</div>
              <h3 class="text-sm font-semibold text-white group-hover:text-baolu-accent transition-colors">{p.product_name}</h3>
              {rSpecs.length > 0 && <div class="mt-2 text-xs text-baolu-gray/70 line-clamp-1">{rSpecs[0].substring(0, 60)}</div>}
            </a>;
          })}
        </div>
      </div>
    </section>
  )}

  <section class="py-12 hero-gradient">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold text-white">Need More Information?</h2>
      <p class="mt-3 text-baolu-light/70 max-w-xl mx-auto">Our team is ready to provide detailed specifications, customize solutions, and answer your questions.</p>
      <div class="mt-6">
        <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 rounded-lg bg-baolu-accent text-white font-semibold hover:bg-baolu-accent/90">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
          Contact Sales Team
        </a>
      </div>
    </div>
  </section>
</Layout>
