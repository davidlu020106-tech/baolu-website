---
import Layout from "../../../layouts/Layout.astro";
import ProductSpecs from "../../../components/ProductSpecs.astro";

export async function getStaticPaths() {
  const categoryTitles = {
    radar: "Radar Systems", jammer: "Countermeasure Systems",
    spectrum: "Spectrum Detection", individual: "Individual Gear",
    eoir: "EO/IR Systems", solution: "Integrated Solutions",
  };
  function toSlug(name) {
    return name.toLowerCase().replace(/[^a-z0-9一-鿿]+/g, "-").replace(/^-|-$/g, "").substring(0, 80);
  }
  const globbed = import.meta.glob("../../../data/products-catalog.json", { eager: true, import: "default" });
  const fPath = Object.keys(globbed)[0];
  const catalog = fPath ? globbed[fPath] : {};
  const paths = [];
  for (const [cat, products] of Object.entries(catalog)) {
    const title = categoryTitles[cat] || cat;
    for (const product of products) {
      paths.push({
        params: { category: cat, slug: toSlug(product.product_name) },
        props: { product, categoryTitle: title },
      });
    }
  }
  return paths;
}

const { product, categoryTitle } = Astro.props;
const specLines = (product.raw_specs || []).filter(s => s.trim());
---
<Layout title={`${product.product_name} — Baolu Tech ${categoryTitle}`}>
  <section class="bg-baolu-dark/80 border-b border-baolu-blue/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <nav class="text-sm text-baolu-gray">
        <a href="/" class="hover:text-baolu-accent">Home</a><span class="mx-2">/</span>
        <a href="/products" class="hover:text-baolu-accent">Products</a><span class="mx-2">/</span>
        <a href={`/products/${Astro.params.category}`} class="hover:text-baolu-accent">{categoryTitle}</a><span class="mx-2">/</span>
        <span class="text-baolu-light">{product.product_name}</span>
      </nav>
    </div>
  </section>
  <section class="hero-gradient py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row gap-8 items-start">
        <div class="w-full lg:w-96 aspect-4/3 rounded-xl bg-baolu-navy/60 border border-baolu-blue/20 flex items-center justify-center shrink-0">
          <div class="text-center text-baolu-gray text-sm">Product Image</div>
        </div>
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-baolu-accent/20 text-baolu-accent">{categoryTitle}</span>
            <span class="text-xs text-baolu-gray/60">{product.source || "Baolu Tech"}</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold text-white leading-tight">{product.product_name}</h1>
          <p class="mt-4 text-baolu-light/70 leading-relaxed max-w-2xl">{product.description || "High-performance security system."}</p>
          {specLines.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-3">
              {specLines.slice(0, 3).map(spec => {
                const clean = spec.replace(/^[：:]s*/, "").substring(0, 40);
                return <span class="text-xs px-3 py-1.5 rounded-lg bg-baolu-blue/20 text-baolu-light/80 border border-baolu-blue/20">{clean}</span>;
              })}
            </div>
          )}
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/contact" class="inline-flex items-center px-6 py-3 rounded-lg bg-baolu-accent text-white font-semibold hover:bg-baolu-accent/90">Inquire About This Product</a>
            <a href={`/products/${Astro.params.category}`} class="inline-flex items-center px-6 py-3 rounded-lg border border-baolu-blue text-white font-semibold hover:bg-baolu-blue/20">All {categoryTitle}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="py-12 bg-baolu-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-white mb-6">Technical Specifications</h2>
      <div class="rounded-xl bg-baolu-navy/40 border border-baolu-blue/15 p-5 sm:p-8">
        {specLines.length > 0 ? <ProductSpecs specs={specLines} /> : <p class="text-baolu-gray">Contact us for detailed specifications.</p>}
      </div>
    </div>
  </section>
  <section class="py-12 hero-gradient">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold text-white">Need More Information?</h2>
      <p class="mt-3 text-baolu-light/70 max-w-xl mx-auto">Our team is ready to help.</p>
      <div class="mt-6">
        <a href="/contact" class="inline-flex items-center px-8 py-4 rounded-lg bg-baolu-accent text-white font-semibold hover:bg-baolu-accent/90">Contact Sales Team</a>
      </div>
    </div>
  </section>
</Layout>