---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About Us — Baolu Tech">
  <section class="hero-gradient pt-32 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-white">About Baolu Tech</h1>
      <p class="mt-4 text-baolu-light/70 max-w-2xl">Jinan Baolu Technology Co., Ltd. — Your trusted partner in anti-drone and airspace security.</p>
    </div>
  </section>
  <section class="py-16 bg-baolu-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="text-2xl font-bold text-white mb-4">Company Profile</h2>
        <p class="text-baolu-gray mb-6 leading-relaxed">
          Jinan Baolu Technology Co., Ltd. is a professional provider of anti-drone and airspace security solutions.
          Specializing in radar systems, countermeasure technologies, spectrum detection, and individual gear,
          we serve military, government, and critical infrastructure clients worldwide.
        </p>
        <p class="text-baolu-gray mb-6 leading-relaxed">
          Founded in Jinan, Shandong, China, our team combines deep expertise in radar engineering,
          electronic warfare, and systems integration to deliver comprehensive counter-UAS solutions.
        </p>
        <div class="grid grid-cols-3 gap-6 mt-12 text-center">
          <div class="rounded-xl bg-baolu-navy/50 p-6">
            <span class="text-3xl font-bold text-baolu-accent">15+</span>
            <p class="text-sm text-baolu-gray mt-2">Years of Experience</p>
          </div>
          <div class="rounded-xl bg-baolu-navy/50 p-6">
            <span class="text-3xl font-bold text-baolu-accent">50+</span>
            <p class="text-sm text-baolu-gray mt-2">Countries Exported</p>
          </div>
          <div class="rounded-xl bg-baolu-navy/50 p-6">
            <span class="text-3xl font-bold text-baolu-accent">200+</span>
            <p class="text-sm text-baolu-gray mt-2">Projects Delivered</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>