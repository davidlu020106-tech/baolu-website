---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
---
<Layout title="Integrated Anti-Drone Solutions — Baolu Tech" description="Turnkey counter-UAS platforms for airports, military, border defense, critical infrastructure and VIP security. Multi-sensor fusion with automated response." keywords="anti-drone solutions, counter-UAS systems, airport drone defense, military C-UAS, integrated security">

  <!-- FAQ Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What types of anti-drone systems does Baolu Tech offer?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Baolu Tech offers a comprehensive range of anti-drone systems including radar systems (24 models), RF jammers, spectrum detectors, EO/IR cameras, individual gear, and fully integrated multi-sensor platforms. Our product portfolio covers the complete detection-to-countermeasure chain."
        }
      },
      {
        "@type": "Question",
        "name": "What is the detection range of your anti-drone radars?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Our radar systems detect small UAVs (RCS=0.01m²) at ranges from 5km up to 20km depending on the model. We offer low-altitude surveillance radars, ground surveillance radars, and maritime surveillance radars with phased array and pulse-Doppler technologies."
        }
      },
      {
        "@type": "Question",
        "name": "Are Baolu Tech products certified for international export?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, all our products are certified with CE, FCC, and ISO standards, ensuring compliance with international quality and safety requirements. Jinan Baolu Technology Co., Ltd. has been exporting to over 50 countries since our founding in 2015."
        }
      },
      {
        "@type": "Question",
        "name": "Do you offer customized anti-drone solutions?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, we provide tailored configurations for specific applications including airports, border defense, military bases, critical infrastructure, VIP security, and correctional facilities. Our 120-person team includes engineers who can customize hardware and software to meet specific operational requirements."
        }
      },
      {
        "@type": "Question",
        "name": "What industries can benefit from your anti-drone systems?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Our solutions serve a wide range of sectors: airports (preventing flight disruptions), border defense (detecting illegal cross-border drones), military (base and convoy protection), critical infrastructure (power plants, data centers), VIP security (event and venue protection), and correctional facilities (preventing contraband deliveries)."
        }
      }
    ]
  }
  </script>

  <section class="hero-gradient pt-32 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-white">Integrated Solutions</h1>
      <p class="mt-4 text-baolu-light/70 max-w-3xl">Complete anti-drone systems combining radar, RF detection, optoelectronics, and countermeasures into unified, turnkey solutions for any environment.</p>
    </div>
  </section>
  <section class="py-16 bg-baolu-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader title="Multi-Sensor Integrated Systems" subtitle="Turnkey counter-UAS solutions with sensor fusion and automated response" />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        <div class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-6">
          <h3 class="text-lg font-semibold text-white mb-2">Airports</h3>
          <p class="text-sm text-baolu-gray">Comprehensive airspace monitoring to prevent drone-related disruptions, ensure flight safety, and protect passengers.</p>
        </div>
        <div class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-6">
          <h3 class="text-lg font-semibold text-white mb-2">Border Defense</h3>
          <p class="text-sm text-baolu-gray">Long-range radar detection and tracking for border security against unauthorized drone incursions and smuggling.</p>
        </div>
        <div class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-6">
          <h3 class="text-lg font-semibold text-white mb-2">Military</h3>
          <p class="text-sm text-baolu-gray">Tactical anti-drone solutions for base protection, convoy security, battlefield airspace management, and force protection.</p>
        </div>
        <div class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-6">
          <h3 class="text-lg font-semibold text-white mb-2">Critical Infrastructure</h3>
          <p class="text-sm text-baolu-gray">Protect power plants, data centers, oil refineries, and water facilities from drone-based espionage and attacks.</p>
        </div>
        <div class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-6">
          <h3 class="text-lg font-semibold text-white mb-2">VIP Security</h3>
          <p class="text-sm text-baolu-gray">Mobile rapid-deployment systems for securing high-profile events, venues, and government convoys.</p>
        </div>
        <div class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-6">
          <h3 class="text-lg font-semibold text-white mb-2">Correctional Facilities</h3>
          <p class="text-sm text-baolu-gray">Prevent drone-delivered contraband (phones, drugs, weapons) and unauthorized surveillance over prisons.</p>
        </div>
      </div>
      <div class="text-center mt-8 pt-8 border-t border-baolu-blue/20">
        <a href="/contact" class="inline-flex items-center px-8 py-4 rounded-lg bg-baolu-accent text-white font-semibold text-lg hover:bg-baolu-accent/90 transition-colors">
          Request a Custom Solution
        </a>
      </div>
    </div>
  </section>
</Layout>
