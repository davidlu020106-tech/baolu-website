---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Solutions — Baolu Tech Anti-Drone Systems">
  <section class="hero-gradient pt-32 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-white">Industry Solutions</h1>
      <p class="mt-4 text-baolu-light/70 max-w-2xl">Tailored anti-drone solutions for critical sectors worldwide.</p>
    </div>
  </section>
  <section class="py-16 bg-baolu-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-6">
          <h3 class="text-lg font-semibold text-white mb-2">Airports</h3>
          <p class="text-sm text-baolu-gray">Comprehensive airspace monitoring to prevent drone-related disruptions and ensure flight safety.</p>
        </div>
        <div class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-6">
          <h3 class="text-lg font-semibold text-white mb-2">Border Defense</h3>
          <p class="text-sm text-baolu-gray">Long-range detection and tracking for border security against unauthorized drone incursions.</p>
        </div>
        <div class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-6">
          <h3 class="text-lg font-semibold text-white mb-2">Military</h3>
          <p class="text-sm text-baolu-gray">Tactical anti-drone solutions for base protection and battlefield airspace management.</p>
        </div>
        <div class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-6">
          <h3 class="text-lg font-semibold text-white mb-2">Critical Infrastructure</h3>
          <p class="text-sm text-baolu-gray">Protect power plants, data centers, and oil refineries from drone threats.</p>
        </div>
        <div class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-6">
          <h3 class="text-lg font-semibold text-white mb-2">VIP Security</h3>
          <p class="text-sm text-baolu-gray">Mobile rapid-deployment systems for securing VIP events and venues.</p>
        </div>
        <div class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-6">
          <h3 class="text-lg font-semibold text-white mb-2">Correctional</h3>
          <p class="text-sm text-baolu-gray">Prevent drone-delivered contraband and unauthorized surveillance.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>