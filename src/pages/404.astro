---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found — Baolu Tech">
  <section class="hero-gradient min-h-screen flex items-center pt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-lg mx-auto">
        <div class="text-8xl font-bold text-baolu-accent/30 mb-4">404</div>
        <h1 class="text-3xl font-bold text-white mb-4">Page Not Found</h1>
        <p class="text-baolu-gray mb-8 leading-relaxed">
          The page you are looking for might have been moved or doesn't exist.
          Please check the URL or navigate to one of our main pages.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/" class="inline-flex items-center px-6 py-3 rounded-lg bg-baolu-accent text-white font-semibold hover:bg-baolu-accent/90 transition-colors">
            Back to Home
          </a>
          <a href="/products" class="inline-flex items-center px-6 py-3 rounded-lg border border-baolu-blue text-white font-semibold hover:bg-baolu-blue/20 transition-colors">
            Browse Products
          </a>
          <a href="/contact" class="inline-flex items-center px-6 py-3 rounded-lg border border-baolu-blue text-white font-semibold hover:bg-baolu-blue/20 transition-colors">
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
