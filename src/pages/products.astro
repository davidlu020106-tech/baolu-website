---
import Layout from "../layouts/Layout.astro";
---
<Layout title="All Products — Baolu Tech Anti-Drone Systems" description="Browse 51+ anti-drone systems across 6 categories: radar, jammers, spectrum detection, EO/IR cameras, individual gear and integrated turnkey solutions." keywords="anti-drone products, counter-UAS equipment, drone defense systems, radar systems, drone jammers">
  <section class="hero-gradient pt-32 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-white">Our Products</h1>
      <p class="mt-4 text-baolu-light/70 max-w-2xl">Comprehensive anti-drone and optoelectronic product portfolio — 51+ systems available across 6 categories.</p>
    </div>
  </section>
  <section class="py-16 bg-baolu-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <a href="/products/radar" class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-8 group">
          <h2 class="text-2xl font-bold text-white group-hover:text-baolu-accent transition-colors">Radar Systems</h2>
          <p class="mt-2 text-baolu-gray">24 models — Low-altitude, ground, and maritime surveillance radars.</p>
          <span class="mt-4 inline-block text-baolu-accent font-medium">Browse 24 Radars →</span>
        </a>
        <a href="/products/jammer" class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-8 group">
          <h2 class="text-2xl font-bold text-white group-hover:text-baolu-accent transition-colors">Countermeasure Systems</h2>
          <p class="mt-2 text-baolu-gray">5 systems — RF jammers, navigation deception, laser interception.</p>
          <span class="mt-4 inline-block text-baolu-accent font-medium">Browse 5 Jammers →</span>
        </a>
        <a href="/products/spectrum" class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-8 group">
          <h2 class="text-2xl font-bold text-white group-hover:text-baolu-accent transition-colors">Spectrum Detection</h2>
          <p class="mt-2 text-baolu-gray">4 systems — Passive RF detection and spectrum analysis.</p>
          <span class="mt-4 inline-block text-baolu-accent font-medium">Browse 4 Detectors →</span>
        </a>
        <a href="/products/individual-gear" class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-8 group">
          <h2 class="text-2xl font-bold text-white group-hover:text-baolu-accent transition-colors">Individual Gear</h2>
          <p class="mt-2 text-baolu-gray">1 system — Portable integrated detection and countermeasure equipment.</p>
          <span class="mt-4 inline-block text-baolu-accent font-medium">Browse 1 Gear →</span>
        </a>
        <a href="/products/eo-ir" class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-8 group">
          <h2 class="text-2xl font-bold text-white group-hover:text-baolu-accent transition-colors">EO/IR Systems</h2>
          <p class="mt-2 text-baolu-gray">15 systems — Multi-sensor PTZ cameras, thermal imaging, laser illumination.</p>
          <span class="mt-4 inline-block text-baolu-accent font-medium">Browse 15 EO/IR →</span>
        </a>
        <a href="/solutions" class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-8 group">
          <h2 class="text-2xl font-bold text-white group-hover:text-baolu-accent transition-colors">Integrated Solutions</h2>
          <p class="mt-2 text-baolu-gray">2 systems — Turnkey multi-sensor counter-UAS platforms.</p>
          <span class="mt-4 inline-block text-baolu-accent font-medium">Browse 2 Solutions →</span>
        </a>
      </div>
    </div>
  </section>
</Layout>