---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Baolu Tech — Radar-Centric Anti-Drone & Airspace Security Solutions">
  <section class="hero-gradient min-h-screen flex items-center pt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight">
            <span class="text-white">Radar-Centric</span><br />
            <span class="text-baolu-accent">Anti-Drone</span>
            <span class="text-white"> Solutions</span>
          </h1>
          <p class="mt-6 text-lg text-baolu-light/70 max-w-xl leading-relaxed">
            Jinan Baolu Technology Co., Ltd. specializes in advanced radar systems,
            countermeasure technologies, spectrum detection, and integrated airspace
            security solutions for military, government, and critical infrastructure.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/products" class="inline-flex items-center px-6 py-3 rounded-lg bg-baolu-accent text-white font-semibold hover:bg-baolu-accent/90 transition-colors">
              Explore Products
            </a>
            <a href="/contact" class="inline-flex items-center px-6 py-3 rounded-lg border border-baolu-blue text-white font-semibold hover:bg-baolu-blue/20 transition-colors">
              Contact Sales
            </a>
          </div>
          <div class="mt-12 flex items-center gap-8 text-sm text-baolu-gray">
            <div>
              <span class="block text-2xl font-bold text-white">15+</span>
              Years Experience
            </div>
            <div>
              <span class="block text-2xl font-bold text-white">50+</span>
              Countries Exported
            </div>
            <div>
              <span class="block text-2xl font-bold text-white">200+</span>
              Projects Delivered
            </div>
          </div>
        </div>
        <div class="hidden lg:flex items-center justify-center">
          <div class="w-full aspect-square rounded-2xl bg-baolu-blue/30 border border-baolu-blue/20 flex items-center justify-center">
            <span class="text-baolu-gray text-lg">Radar System Visualization</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-baolu-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-white">Our Product Lines</h2>
        <p class="mt-4 text-baolu-gray max-w-2xl mx-auto">
          Comprehensive anti-drone solutions from detection to countermeasure, built on advanced radar technology.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-6">
          <div class="w-12 h-12 rounded-lg bg-baolu-accent/20 flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#e67e22" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Radar Systems</h3>
          <p class="text-sm text-baolu-gray">Low-altitude & ground surveillance radars with phased array technology.</p>
          <a href="/products/radar" class="mt-4 inline-block text-sm text-baolu-accent font-medium hover:underline">Learn More →</a>
        </div>
        <div class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-6">
          <div class="w-12 h-12 rounded-lg bg-baolu-warning/20 flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#e74c3c" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.348 14.652a3.75 3.75 0 0 1 0-5.304m5.304 0a3.75 3.75 0 0 1 0 5.304m-7.425 2.121a6.75 6.75 0 0 1 0-9.546m9.546 0a6.75 6.75 0 0 1 0 9.546M5.106 18.894c-3.808-3.807-3.808-9.98 0-13.788m13.788 0c3.808 3.807 3.808 9.98 0 13.788" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Countermeasure Systems</h3>
          <p class="text-sm text-baolu-gray">Handheld & fixed jammers covering multiple frequency bands.</p>
          <a href="/products/jammer" class="mt-4 inline-block text-sm text-baolu-accent font-medium hover:underline">Learn More →</a>
        </div>
        <div class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-6">
          <div class="w-12 h-12 rounded-lg bg-blue-500/20 flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#3b82f6" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Spectrum Detection</h3>
          <p class="text-sm text-baolu-gray">Passive RF detection & spectrum analysis for drone ID.</p>
          <a href="/products/spectrum" class="mt-4 inline-block text-sm text-baolu-accent font-medium hover:underline">Learn More →</a>
        </div>
        <div class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-6">
          <div class="w-12 h-12 rounded-lg bg-emerald-500/20 flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#10b981" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Individual Gear</h3>
          <p class="text-sm text-baolu-gray">Portable integrated detection & countermeasure equipment.</p>
          <a href="/products/individual-gear" class="mt-4 inline-block text-sm text-baolu-accent font-medium hover:underline">Learn More →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-baolu-navy/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-white">Industries We Serve</h2>
        <p class="mt-4 text-baolu-gray max-w-2xl mx-auto">Tailored anti-drone solutions for critical sectors worldwide.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        <div class="rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-4 text-center hover:border-baolu-accent/50 transition-colors">
          <span class="text-sm font-medium text-white">Airports</span>
        </div>
        <div class="rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-4 text-center hover:border-baolu-accent/50 transition-colors">
          <span class="text-sm font-medium text-white">Border Defense</span>
        </div>
        <div class="rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-4 text-center hover:border-baolu-accent/50 transition-colors">
          <span class="text-sm font-medium text-white">Military</span>
        </div>
        <div class="rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-4 text-center hover:border-baolu-accent/50 transition-colors">
        
