---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Baolu Tech — Radar-Centric Anti-Drone & Airspace Security Solutions">
  <section class="hero-gradient min-h-screen flex items-center pt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight">
            <span class="text-white">Radar-Centric</span><br />
            <span class="text-baolu-accent">Anti-Drone</span>
            <span class="text-white"> Solutions</span>
          </h1>
          <p class="mt-6 text-lg text-baolu-light/70 max-w-xl leading-relaxed">
            Jinan Baolu Technology Co., Ltd. specializes in advanced radar systems,
            countermeasure technologies, spectrum detection, and integrated airspace
            security solutions for military, government, and critical infrastructure.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/products" class="inline-flex items-center px-6 py-3 rounded-lg bg-baolu-accent text-white font-semibold hover:bg-baolu-accent/90 transition-colors">
              Explore Products
            </a>
            <a href="/contact" class="inline-flex items-center px-6 py-3 rounded-lg border border-baolu-blue text-white font-semibold hover:bg-baolu-blue/20 transition-colors">
              Contact Sales
            </a>
          </div>
          <div class="mt-12 flex items-center gap-8 text-sm text-baolu-gray">
            <div>
              <span class="block text-2xl font-bold text-white">15+</span>
              Years Experience
            </div>
            <div>
              <span class="block text-2xl font-bold text-white">50+</span>
              Countries Exported
            </div>
            <div>
              <span class="block text-2xl font-bold text-white">200+</span>
              Projects Delivered
            </div>
          </div>
        </div>
        <div class="hidden lg:flex items-center justify-center">
          <div class="w-full aspect-square rounded-2xl bg-baolu-blue/30 border border-baolu-blue/20 flex items-center justify-center">
            <span class="text-baolu-gray text-lg">Radar System Visualization</span>
          </div>
        </div>
      </div>
    </div>
  </section>

    <section class="py-20 bg-baolu-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-white">Our Product Lines</h2>
        <p class="mt-4 text-baolu-gray max-w-2xl mx-auto">
          Comprehensive anti-drone solutions from detection to countermeasure &mdash; 51+ systems covering radar, jamming, spectrum detection, individual gear, and integrated platforms.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-6">
          <h3 class="text-lg font-semibold text-white mb-2">Radar Systems</h3>
          <p class="text-sm text-baolu-gray mb-1">24 radars</p>
          <p class="text-sm text-baolu-gray">Low-altitude, ground &amp; maritime surveillance radars. Detection range up to 20km.</p>
          <a href="/products/radar" class="mt-4 inline-block text-sm text-baolu-accent font-medium hover:underline">Browse All Radars →</a>
        </div>
        <div class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-6">
          <h3 class="text-lg font-semibold text-white mb-2">Countermeasure Systems</h3>
          <p class="text-sm text-baolu-gray mb-1">5 jammers</p>
          <p class="text-sm text-baolu-gray">Multi-band RF jammers, navigation deception &amp; laser interception.</p>
          <a href="/products/jammer" class="mt-4 inline-block text-sm text-baolu-accent font-medium hover:underline">Browse All Jammers →</a>
        </div>
        <div class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-6">
          <h3 class="text-lg font-semibold text-white mb-2">Spectrum Detection</h3>
          <p class="text-sm text-baolu-gray mb-1">4 detectors</p>
          <p class="text-sm text-baolu-gray">Passive RF detection 70MHz-6GHz, drone identification &amp; tracking.</p>
          <a href="/products/spectrum" class="mt-4 inline-block text-sm text-baolu-accent font-medium hover:underline">Browse All Detectors →</a>
        </div>
        <div class="card-hover rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-6">
          <h3 class="text-lg font-semibold text-white mb-2">Individual Gear</h3>
          <p class="text-sm text-baolu-gray mb-1">15 EO/IR + portable</p>
          <p class="text-sm text-baolu-gray">Lightweight, rapid-deployment anti-drone equipment for field operators.</p>
          <a href="/products/individual-gear" class="mt-4 inline-block text-sm text-baolu-accent font-medium hover:underline">Browse All Gear →</a>
        </div>
      </div>
    </div>
  </section>
<section class="py-20 bg-baolu-navy/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-white">Industries We Serve</h2>
        <p class="mt-4 text-baolu-gray max-w-2xl mx-auto">Tailored anti-drone solutions for critical sectors worldwide.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        <div class="rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-4 text-center hover:border-baolu-accent/50 transition-colors">
          <span class="text-sm font-medium text-white">Airports</span>
        </div>
        <div class="rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-4 text-center hover:border-baolu-accent/50 transition-colors">
          <span class="text-sm font-medium text-white">Border Defense</span>
        </div>
        <div class="rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-4 text-center hover:border-baolu-accent/50 transition-colors">
          <span class="text-sm font-medium text-white">Military</span>
        </div>
        <div class="rounded-xl bg-baolu-navy/50 border border-baolu-blue/20 p-4 text-center hover:border-baolu-accent/50 transition-colors">
        
